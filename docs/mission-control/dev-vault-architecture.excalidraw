  "source": "https://excalidraw.com",
  "elements": [
    {"id":"architecture-title","type":"text","x":40,"y":28,"width":1080,"height":45,"text":"Dev Vault: one local vault per Paseo host","fontSize":28,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e293b","backgroundColor":"transparent","angle":0,"seed":101,"version":1,"versionNonce":101,"isDeleted":false,"groupIds":[],"opacity":100},
    {"id":"mission-ui-box","type":"rectangle","x":40,"y":120,"width":300,"height":360,"strokeColor":"#1971c2","backgroundColor":"#e7f5ff","fillStyle":"solid","strokeWidth":2,"roughness":1,"angle":0,"seed":102,"version":1,"versionNonce":102,"isDeleted":false,"groupIds":[],"opacity":100},
    {"id":"mission-ui-text","type":"text","x":62,"y":145,"width":256,"height":300,"text":"MISSION CONTROL\n\nHost: personal  |  remote\nWorkspace: development-flow\n\nTasks tab\n• create task folder\n• change lifecycle status\n\nDocs tab\n• choose task + document\n• read / edit Markdown\n• save / reload","fontSize":18,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#0b3a67","backgroundColor":"transparent","angle":0,"seed":103,"version":1,"versionNonce":103,"isDeleted":false,"groupIds":[],"opacity":100},
    {"id":"adapter-box","type":"rectangle","x":450,"y":150,"width":260,"height":300,"strokeColor":"#2b8a3e","backgroundColor":"#ebfbee","fillStyle":"solid","strokeWidth":2,"roughness":1,"angle":0,"seed":104,"version":1,"versionNonce":104,"isDeleted":false,"groupIds":[],"opacity":100},
    {"id":"adapter-text","type":"text","x":474,"y":176,"width":214,"height":240,"text":"HOST ADAPTER\n\nRuns on owning host\nChecks host.json identity\nChecks workspace assignment\nReads task Markdown\nRejects stale note saves\nWrites local files only","fontSize":18,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1b5e2a","backgroundColor":"transparent","angle":0,"seed":105,"version":1,"versionNonce":105,"isDeleted":false,"groupIds":[],"opacity":100},
    {"id":"vault-box","type":"rectangle","x":820,"y":105,"width":390,"height":390,"strokeColor":"#e67700","backgroundColor":"#fff9db","fillStyle":"solid","strokeWidth":2,"roughness":1,"angle":0,"seed":106,"version":1,"versionNonce":106,"isDeleted":false,"groupIds":[],"opacity":100},
    {"id":"vault-text","type":"text","x":845,"y":130,"width":340,"height":330,"text":"C:\\dev-vault\\\n\nTasks / task_<stable-id> /\n  task.md       ← current status + brief\n  status.md     ← progress log\n  notes.md      ← working notes\n  design.md     ← optional document\n  attachments/  ← future files\n\nProjects / Daily / Templates /\n.obsidian / host.json / README.md","fontSize":18,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#754100","backgroundColor":"transparent","angle":0,"seed":107,"version":1,"versionNonce":107,"isDeleted":false,"groupIds":[],"opacity":100},
    {"id":"obsidian-box","type":"rectangle","x":820,"y":545,"width":390,"height":100,"strokeColor":"#7048e8","backgroundColor":"#f3f0ff","fillStyle":"solid","strokeWidth":2,"roughness":1,"angle":0,"seed":108,"version":1,"versionNonce":108,"isDeleted":false,"groupIds":[],"opacity":100},
    {"id":"obsidian-text","type":"text","x":845,"y":562,"width":345,"height":65,"text":"OBSIDIAN / TEXT EDITOR\nOpens the same ordinary Markdown files","fontSize":18,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#5f3dc4","backgroundColor":"transparent","angle":0,"seed":109,"version":1,"versionNonce":109,"isDeleted":false,"groupIds":[],"opacity":100},
    {"id":"ui-to-adapter","type":"arrow","x":342,"y":290,"width":105,"height":0,"points":[[0,0],[105,0]],"strokeColor":"#475569","strokeWidth":2,"endArrowhead":"arrow","startArrowhead":null,"angle":0,"seed":110,"version":1,"versionNonce":110,"isDeleted":false,"groupIds":[],"opacity":100},
    {"id":"adapter-to-vault","type":"arrow","x":712,"y":290,"width":105,"height":0,"points":[[0,0],[105,0]],"strokeColor":"#475569","strokeWidth":2,"endArrowhead":"arrow","startArrowhead":null,"angle":0,"seed":111,"version":1,"versionNonce":111,"isDeleted":false,"groupIds":[],"opacity":100},
    {"id":"vault-to-obsidian","type":"arrow","x":1015,"y":497,"width":0,"height":45,"points":[[0,0],[0,45]],"strokeColor":"#7048e8","strokeWidth":2,"endArrowhead":"arrow","startArrowhead":"arrow","angle":0,"seed":112,"version":1,"versionNonce":112,"isDeleted":false,"groupIds":[],"opacity":100},
    {"id":"host-note","type":"text","x":43,"y":525,"width":710,"height":110,"text":"Each Windows host has its own C:\\dev-vault.\nA remote host needs its own adapter before the personal client can edit its files.\nTask IDs stay stable even if titles or projects change.","fontSize":17,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#475569","backgroundColor":"transparent","angle":0,"seed":113,"version":1,"versionNonce":113,"isDeleted":false,"groupIds":[],"opacity":100}
  ],
